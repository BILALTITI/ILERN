@using Assigment2.ViewModel
@model List<Instructor>
@{
    ViewData["Title"] = "Instructor List";
    Layout = "_MyLayout";
    ViewData["ControllerName"] = "Instructor";
    ViewData["ActionName"] = "Index";

    // Ensure ViewBag.Pager is assigned correctly
    PagedResult pagedResult = ViewBag.Pager as PagedResult ?? new PagedResult();
    int pageno = pagedResult.CurrentPage;
}
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

</head>
<style>
    .instructor-table {
        --bs-table-bg: #f8f9fa;
        border-collapse: separate;
        border-spacing: 0 0.75rem;
    }

        .instructor-table thead {
            background: linear-gradient(45deg, #007bff, #00a8ff);
            color: white;
        }

    .instructor-img {
        width: 60px;
        height: 60px;
        transition: transform 0.3s ease;
        object-fit: cover;
    }

        .instructor-img:hover {
            transform: scale(1.8);
            z-index: 1000;
        }

    .action-buttons .btn {
        min-width: 100px;
        margin: 2px;
        transition: all 0.2s ease;
    }

    .table-hover tbody tr:hover {
        transform: translateX(8px);
        transition: transform 0.2s ease;
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    }
</style>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-primary mb-0">
            <i class="fas fa-chalkboard-teacher me-2"></i>Instructor List
        </h1>
        <a asp-action="AddNew" asp-controller="Instructor" class="btn btn-success btn-lg">
            <i class="fas fa-user-plus me-2"></i>Add New
        </a>
    </div>

    <div class="table-responsive rounded-3 shadow">
        <table class="instructor-table table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col" class="ps-4">ID</th>
                    <th scope="col">Name</th>
                    <th scope="col">Salary</th>
                    <th scope="col">Address</th>
                    <th scope="col">Department</th>
                    <th scope="col">Course</th>
                    <th scope="col">Photo</th>
                    <th scope="col" class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var instructor in Model)
                {
                    <tr class="bg-white">
                        <td class="ps-4 fw-bold text-primary">@instructor.InstructorId</td>
                        <td>@instructor.Name</td>
                        <td>$@instructor.Salary.ToString("N0")</td>
                        <td>@instructor.Address</td>
                        <td>@instructor.Department?.Name</td>
                        <td>@instructor.Course?.Name</td>
                        <td>
                            <img src="@Url.Content(instructor.Image)"
                                 alt="@instructor.Name's profile photo"
                                 class="instructor-img rounded-circle shadow-sm">
                        </td>
                        <td class="action-buttons text-center">
                            <a href="/Instructor/Edit/@instructor.InstructorId"
                               class="btn btn-warning btn-sm"
                               aria-label="Edit @instructor.Name">
                                <i class="fas fa-edit me-1"></i>Edit
                            </a>
                            <button onclick="showDeleteModal(@instructor.InstructorId, '@instructor.Name')"
                                    class="btn btn-danger btn-sm"
                                    aria-label="Delete @instructor.Name">
                                <i class="fas fa-trash-alt me-1"></i>Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pages" model="@pagedResult" />
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="instructorName"></strong>?
                <p class="text-danger mt-2">This action cannot be undone!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentInstructorId = null;

        function showDeleteModal(id, name) {
            currentInstructorId = id;
            $('#instructorName').text(name);
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        $('#confirmDelete').click(() => {
            if (!currentInstructorId) return;

            $.ajax({
                url: `/Instructor/Delete/${currentInstructorId}`,
                method: 'POST',
                beforeSend: () => {
                    $('#deleteModal').modal('hide');
                    showLoader();
                },
                success: () => {
                    location.reload();
                },
                error: () => {
                    hideLoader();
                    showToast('Error!', 'Failed to delete instructor.', 'danger');
                }
            });
        });

        function showLoader() {
            $('body').append(`
                <div class="loading-overlay d-flex justify-content-center align-items-center">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            `);
        }

        function hideLoader() {
            $('.loading-overlay').remove();
        }

        function showToast(title, message, type = 'success') {
            const toast = $(`
                <div class="toast align-items-center text-white bg-${type} border-0 position-fixed bottom-0 end-0 m-3">
                    <div class="d-flex">
                        <div class="toast-body">
                            <strong>${title}</strong> ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `);

            $('body').append(toast);
            new bootstrap.Toast(toast[0]).show();
        }
    </script>
}