@using Assigment2.Models
@model Instructor

@{
    ViewData["Title"] = Model.InstructorId == 0 ? "Add Instructor" : "Edit Instructor";
    Layout = "_MyLayout";
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-primary text-white rounded-top-4 py-4">
            <h2 class="h4 mb-0">
                <i class="fas @(Model.InstructorId == 0 ? "fa-chalkboard-teacher" : "fa-user-edit") me-2"></i>
                @(Model.InstructorId == 0 ? "Create New Instructor" : "Edit Instructor Profile")
            </h2>
        </div>

        <div class="card-body p-4 p-md-5">
            <form method="post" asp-action="SaveEdit" asp-controller="Instructor" enctype="multipart/form-data" class="needs-validation" novalidate>
                <input type="hidden" asp-for="InstructorId" />

                <div class="col-md-12">
                    <div class="form-floating mb-4">
                        <input asp-for="Name"
                               class="form-control form-control-lg @(ViewData.ModelState["Name"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Instructor  Name" />
                        <label asp-for="Name" class="form-label">
                            <i class="fas fa-graduation-cap me-2"></i>Instructor Name
                        </label>
                        <span asp-validation-for="Name" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating mb-4">
                        <input asp-for="Address"
                               class="form-control form-control-lg @(ViewData.ModelState["Address"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Address" />
                        <label asp-for="Address" class="form-label">
                            <i class="fas fa-graduation-cap me-2"></i>Address
                        </label>
                        <span asp-validation-for="Address" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating mb-4">
                        <input asp-for="Salary"
                               class="form-control form-control-lg @(ViewData.ModelState["Salary"]?.Errors.Any() == true ? "is-invalid" : "")"
                               placeholder="Salary " />
                        <label asp-for="Salary" class="form-label">
                            <i class="fas fa-graduation-cap me-2"></i>Salary
                        </label>
                        <span asp-validation-for="Salary" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="mb-4">
                        <label><i class="fas fa-camera me-2"></i>Profile Photo</label>
                        <input type="file" name="ImageFile" class="form-control form-control-lg" accept="image/*" onchange="previewImage(event)" />
                        <span asp-validation-for="Image" class="text-danger"></span>

                        <div class="image-preview mt-3 text-center">
                            @if (!string.IsNullOrEmpty(Model.Image))
                            {
                                <img src="@Model.Image" class="img-thumbnail rounded-circle shadow" style="width: 120px; height: 120px; object-fit: cover;" id="imagePreview" />
                            }
                            else
                            {
                                <div class="avatar-placeholder rounded-circle bg-light d-inline-block">
                                    <i class="fas fa-user-tie fa-3x text-secondary"></i>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating mb-4">
                        <select asp-for="DepartmentId"
                                class="form-select form-select-lg @(ViewData.ModelState["DepartmentId"]?.Errors.Any() == true ? "is-invalid" : "")"
                                asp-items="ViewBag.DeptList"
                                required>
                            <option value="">Select Department</option>
                        </select>
                        <label asp-for="DepartmentId" class="form-label">
                            <i class="fas fa-building me-2"></i>Department Name
                        </label>
                        <span asp-validation-for="DepartmentId" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="col-md-12">
                    <div class="form-floating mb-4">
                        <select asp-for="CourseId"
                                class="form-select form-select-lg @(ViewData.ModelState["CourseId"]?.Errors.Any() == true ? "is-invalid" : "")"
                                asp-items="ViewBag.CourseList"
                                required>
                            <option value="">Select Course</option>
                        </select>
                        <label asp-for="CourseId" class="form-label">
                            <i class="fas fa-book me-2"></i>Course Name
                        </label>
                        <span asp-validation-for="CourseId" class="invalid-feedback"></span>
                    </div>
                </div>

                <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-5">
                    <a asp-action="Index" asp-controller="Instructor" class="btn btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save me-2"></i>@(Model.InstructorId == 0 ? "Add Instructor" : "Save Changes")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .form-select-lg {
        min-width: 100%;
    }

    .form-floating > label {
        padding-left: 2.5rem;
    }

    .form-control, .form-select {
        padding-left: 2.5rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
            border-color: #0d6efd;
        }

    .invalid-feedback {
        padding-left: 2.5rem;
    }

    .input-validation-error {
        border-color: #dc3545 !important;
    }

    .invalid-feedback {
        display: block;
        color: #dc3545;
        margin-top: 0.25rem;
    }
</style>

<script>
    function previewImage(event) {
        const reader = new FileReader();
        reader.onload = function () {
            const preview = document.getElementById('imagePreview');
            preview.src = reader.result;
        };
        reader.readAsDataURL(event.target.files[0]);
    }

    (() => {
        'use strict'
        const forms = document.querySelectorAll('.needs-validation')
        Array.from(forms).forEach(form => {
            form.addEventListener('submit', event => {
                if (!form.checkValidity()) {
                    event.preventDefault()
                    event.stopPropagation()
                }
                form.classList.add('was-validated')
            }, false)
        })
    })()
</script>