@model Course
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

</head>
<div class="course-card card shadow-sm border-primary">
    <div class="card-header bg-primary text-white">
        <h3 class="card-title mb-0">
            <i class="fas fa-book-open me-2"></i>@Model.Name
        </h3>
    </div>
    <div class="card-body">
        <div class="course-details">
            <div class="detail-item d-flex align-items-center mb-3">
                <i class="fas fa-graduation-cap text-primary me-3 fs-5"></i>
                <div>
                    <div class="text-muted small">Total Degree</div>
                    <div class="fw-bold">@Model.Degree</div>
                </div>
            </div>
            
            <div class="detail-item d-flex align-items-center mb-3">
                <i class="fas fa-check-circle text-success me-3 fs-5"></i>
                <div>
                    <div class="text-muted small">Passing Requirement</div>
                    <div class="fw-bold">@Model.MinDegree</div>
                </div>
            </div>
            
            <div class="detail-item d-flex align-items-center">
                <i class="fas fa-building text-info me-3 fs-5"></i>
                <div>
                    <div class="text-muted small">Course Name  </div>
                    <div class="fw-bold">@Model.Name</div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .course-card {
        transition: all 0.3s ease;
        max-width: 350px;
        min-height: 280px;
    }

    .course-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0, 123, 255, 0.15);
    }

    .card-header {
        border-radius: calc(0.375rem - 1px) calc(0.375rem - 1px) 0 0 !important;
    }

    .detail-item {
        padding: 0.75rem;
        background-color: rgba(248, 249, 250, 0.5);
        border-radius: 8px;
    }

    .detail-item:hover {
        background-color: #f8f9fa;
    }

    .course-details {
        font-size: 0.95rem;
        align-items: center;
    }
</style>