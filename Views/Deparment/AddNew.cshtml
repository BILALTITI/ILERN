@using Assigment2.ViewModel
@model Department

@{
    ViewData["Title"] = Model.DepartmentId == 0 ? "Add Department" : "Edit Department";
    Layout = "_MyLayout";
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-primary text-white rounded-top-4 py-4">
            <h2 class="h4 mb-0">
                <i class="fas @(Model.DepartmentId == 0 ? "fa-building" : "fa-edit") me-2"></i>
                @(Model.DepartmentId == 0 ? "Create New Department" : "Edit Department Details")
            </h2>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="SaveEdit" method="post" class="needs-validation">
                <input type="hidden" asp-for="DepartmentId" />

                <div class="row g-4">
                    <!-- Department Name -->
                    <div class="col-md-12">
                        <div class="form-floating mb-4">
                            <input asp-for="Name" 
                                   class="form-control form-control-lg @(ViewData.ModelState["Name"]?.Errors.Any() == true ? "is-invalid" : "")" 
                                   placeholder="Department Name" required />
                            <label asp-for="Name" class="form-label">
                                <i class="fas fa-university me-2"></i>Department Name
                            </label>
                            <span asp-validation-for="Name" class="invalid-feedback"></span>
                        </div>
                    </div>

                    <!-- Manager Name -->
                    <div class="col-md-12">
                        <div class="form-floating mb-4">
                            <input asp-for="Manager" 
                                   class="form-control form-control-lg @(ViewData.ModelState["Manager"]?.Errors.Any() == true ? "is-invalid" : "")" 
                                   placeholder="Manager Name" required />
                            <label asp-for="Manager" class="form-label">
                                <i class="fas fa-user-tie me-2"></i>Manager Name
                            </label>
                            <span asp-validation-for="Manager" class="invalid-feedback"></span>
                        </div>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-5">
                    <a asp-action="Index" asp-controller="Deparment" class="btn btn-lg btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-lg btn-primary px-4">
                        <i class="fas fa-save me-2"></i>@(Model.DepartmentId == 0 ? "Create Department" : "Save Changes")
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .card {
        border: none;
        transition: transform 0.3s ease;
    }

    .form-floating > label {
        padding-left: 2.5rem;
    }

    .form-control {
        padding-left: 2.5rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

    .input-validation-error {
        border-color: #dc3545 !important;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 12' width='12' height='12' fill='none' stroke='%23dc3545'%3e%3ccircle cx='6' cy='6' r='4.5'/%3e%3cpath d='M5.8 3.6h.4L6 6.5z'/%3e%3ccircle cx='6' cy='8.2' r='.6' fill='%23dc3545' stroke='none'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right calc(0.375em + 0.1875rem) center;
        background-size: calc(0.75em + 0.375rem) calc(0.75em + 0.375rem);
    }

    .form-control:focus {
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
        border-color: #0d6efd;
    }

    .invalid-feedback {
        display: block;
        color: #dc3545;
        padding-left: 2.5rem;
    }
</style>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    
    <!-- Bootstrap validation fallback -->
    <script>
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
}