 
@{
    ViewData["Title"] = "Home";
    Layout = "_Layout";
}

<!DOCTYPE html>
<html lang="en">
<head>
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>

<body class="bg-light">
    <div class="container py-5">
        <!-- Hero Section -->
        <div class="text-center mb-5 animate__animated animate__fadeIn">
            <div class="hero-badge mb-4">
                <i class="fas fa-graduation-cap fa-3x text-white"></i>
            </div>
            <h1 class="display-4 fw-bold mb-3 text-gradient-primary">
                Training Management System
            </h1>
            <p style="    -webkit-text-fill-color: darkgrey;
    line-height: 1;
    font-size: 20px;" class="lead text-muted mx-auto hero-subtitle">
                Streamline your educational institution's management with our comprehensive solution
            </p>
        </div>

        <!-- Dashboard Cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <!-- Instructor Card -->
            <div class="col">
                <div class="card h-100 shadow-lg border-0 hover-scale card-gradient-primary">
                    <div class="card-body text-center p-4 d-flex flex-column">
                        <div class="icon-wrapper bg-primary-light rounded-circle mb-3 mx-auto">
                            <i class="fas fa-chalkboard-teacher fa-2x text-primary"></i>
                        </div>
                        <h3 class="h4 card-title mb-3">Instructors</h3>
                        <p style="    -webkit-text-fill-color: lightslategrey;" class="card-text text-muted mb-4 flex-grow-1">
                            Manage instructor profiles, schedules, and course assignments
                        </p>
                        <a asp-action="Index" asp-controller="Instructor"
                           class="btn btn-primary px-4 rounded-pill btn-hover">
                            Manage Instructors <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Course Card -->
            <div class="col">
                <div class="card h-100 shadow-lg border-0 hover-scale card-gradient-success">
                    <div class="card-body text-center p-4 d-flex flex-column">
                        <div class="icon-wrapper bg-success-light rounded-circle mb-3 mx-auto">
                            <i class="fas fa-book-open fa-2x text-success"></i>
                        </div>
                        <h3 class="h4 card-title mb-3">Courses</h3>
                        <p style="-webkit-text-fill-color: lightslategrey;" class="card-text text-muted mb-4 flex-grow-1">
                            Create and manage course curriculum, schedules, and materials
                        </p>
                        <a asp-action="Index" asp-controller="Course"
                           class="btn btn-success px-4 rounded-pill btn-hover    btn btn-primary px-4 rounded-pill btn-hover">
                            View Courses <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Trainee Card -->
            <div class="col">
                <div class="card h-100 shadow-lg border-0 hover-scale card-gradient-info">
                    <div class="card-body text-center p-4 d-flex flex-column">
                        <div class="icon-wrapper bg-info-light rounded-circle mb-3 mx-auto">
                            <i class="fas fa-user-graduate fa-2x text-info"></i>
                        </div>
                        <h3 class="h4 card-title mb-3">Trainees</h3>
                        <p style ="-webkit-text-fill-color: lightslategrey;" class="card-text text-muted mb-4 flex-grow-1">
                            Track trainee progress, attendance, and performance metrics
                        </p>
                        <a asp-action="Index" asp-controller="Trainee"
                           class="btn btn-info px-4 rounded-pill btn-hover">
                            Manage Trainees <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Results Card -->
            <div class="col">
                <div class="card h-100 shadow-lg border-0 hover-scale card-gradient-warning">
                    <div class="card-body text-center p-4 d-flex flex-column">
                        <div class="icon-wrapper bg-warning-light rounded-circle mb-3 mx-auto">
                            <i class="fas fa-chart-bar fa-2x text-warning"></i>
                        </div>
                        <h3 class="h4 card-title mb-3">Course Results</h3>
                        <p style="-webkit-text-fill-color: lightslategrey;" class="card-text text-muted mb-4 flex-grow-1">
                            Analyze and manage academic results and performance statistics
                        </p>
                        <a asp-action="Index" asp-controller="CourseResult"
                           class="btn btn-warning px-4 rounded-pill btn-hover">
                            View Results <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Department Card -->
            <div class="col">
                <div class="card h-100 shadow-lg border-0 hover-scale card-gradient-danger">
                    <div class="card-body text-center p-4 d-flex flex-column">
                        <div class="icon-wrapper bg-danger-light rounded-circle mb-3 mx-auto">
                            <i class="fas fa-building fa-2x text-danger"></i>
                        </div>
                        <h3 class="h4 card-title mb-3">Departments</h3>
                        <p style="-webkit-text-fill-color: lightslategrey;" class="card-text text-muted mb-4 flex-grow-1">
                            Manage organizational structure and department configurations
                        </p>
                        <a asp-action="Index" asp-controller="Deparment"
                           class="btn btn-danger px-4 rounded-pill btn-hover">
                            View Departments <i class="fas fa-arrow-right ms-2"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #0d6efd 0%, #0b5ed7 100%);
            --success-gradient: linear-gradient(135deg, #198754 0%, #157347 100%);
            --info-gradient: linear-gradient(135deg, #0dcaf0 0%, #0aa2c0 100%);
            --warning-gradient: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
            --danger-gradient: linear-gradient(135deg, #dc3545 0%, #bb2d3b 100%);
            --hover-scale-factor: 1.02;
        }

        .hero-badge {
            width: 100px;
            height: 100px;
            background: var(--primary-gradient);
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 10px 20px rgba(13,110,253,0.2);
            transition: transform 0.3s ease;
        }

            .hero-badge:hover {
                transform: rotate(15deg);
            }
            .hero-badge p{
                color:white;
            }
        .text-gradient-primary {
            background: var(--primary-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hover-scale {
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            cursor: pointer;
        }

            .hover-scale:hover {
                transform: translateY(-5px) scale(var(--hover-scale-factor));
                box-shadow: 0 15px 30px rgba(0,0,0,0.1) !important;
            }

        [class*="card-gradient"]::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            border-radius: 4px 4px 0 0;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .card-gradient-primary::before {
            background: var(--primary-gradient);
        }

        .card-gradient-success::before {
            background: var(--success-gradient);
        }

        .card-gradient-info::before {
            background: var(--info-gradient);
        }

        .card-gradient-warning::before {
            background: var(--warning-gradient);
        }

        .card-gradient-danger::before {
            background: var(--danger-gradient);
        }

        [class*="card-gradient"]:hover::before {
            opacity: 1;
        }

        .btn-hover {
            position: relative;
            overflow: hidden;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-hover::after {
                content: '';
                position: absolute;
                top: -50%;
                left: -50%;
                width: 200%;
                height: 200%;
                background: rgba(255,255,255,0.1);
                transform: rotate(45deg);
                transition: all 0.5s ease;
            }

            .btn-hover:hover::after {
                left: 50%;
                top: 50%;
            }

        .icon-wrapper {
            width: 80px;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: transform 0.3s ease;
        }

        .card:hover .icon-wrapper {
            transform: rotate(360deg);
        }

        .hero-subtitle {
            font-size: 1.25rem;
            line-height: 1.6;
            position: relative;
            padding-bottom: 1rem;
        }

            .hero-subtitle::after {
                content: '';
                display: block;
                width: 60px;
                height: 3px;
                background: var(--primary-gradient);
                margin: 1rem auto 0;
                border-radius: 2px;
            }

        @@media (max-width: 768px) {
            .hero-badge

        {
            width: 80px;
            height: 80px;
        }

        .display-4 {
            font-size: 2.5rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
        }

        }

        .bg-primary-light {
            background-color: rgba(13,110,253,0.1)
        }

        .bg-success-light {
            background-color: rgba(25,135,84,0.1)
        }

        .bg-info-light {
            background-color: rgba(13,202,240,0.1)
        }

        .bg-warning-light {
            background-color: rgba(255,193,7,0.1)
        }

        .bg-danger-light {
            background-color: rgba(220,53,69,0.1)
        }

        .card-btn {
            width: 100%;
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            font-weight: 500;
            border-radius: 2rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
        }

    </style>
     
</body>
</html>