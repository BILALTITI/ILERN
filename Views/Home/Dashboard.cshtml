@using Assigment2.ViewModel
@{
    Layout = "_Layout";

    var categoryCounts = ViewBag.CategoryData as Dictionary<string, int> ?? new Dictionary<string, int>();
    var categories = categoryCounts.Keys.ToArray();
    var counts = categoryCounts.Values.ToArray();
}

<!-- Add required dependencies -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<script src="https://cdn.plot.ly/plotly-latest.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

<!-- Dashboard Container -->
<div class="dashboard-container">
    <!-- Sidebar -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h3><i class="fas fa-chart-line"></i> Dashboard</h3>
        </div>
        <ul class="sidebar-menu">
            <li><a asp-action="Index" asp-controller="Home"><i class="fas fa-home"></i> Home</a></li>
            <li><a asp-action="Profile" asp-controller="Account"><i class="fas fa-user"></i> Profile</a></li>
            <li><a asp-action="Settings" asp-controller="Account"><i class="fas fa-cog"></i> Settings</a></li>
        </ul>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Top Bar -->
        <div class="top-bar">
            <div class="top-bar-left">
                <h2>Welcome, @Model.UserName</h2>
            </div>
            <button class="btn-logout" onclick="showLogoutConfirmation()">
                <i class="fas fa-sign-out-alt"></i> Logout
            </button>
        </div>

        <!-- Dashboard Stats -->
        <div class="dashboard-stats">
            <div class="stat-card">
                <h3>Total Users</h3>
                <p>@Model.UsersCounter</p>
            </div>
            <div class="stat-card">
                <h3>Total Department</h3>
                <p>@Model.DepartmentCounter</p>
            </div>
            <div class="stat-card">
                <h3>Total Trainee</h3>
                <p>@Model.TraineeCounter</p>
            </div>
            <div class="stat-card">
                <h3>Total Courses</h3>
                <p>@Model.CourseCounter</p>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="charts">
            <div class="chart-container">
                <div class="chart-card">
                    <h3><i class="fas fa-chart-pie"></i> Category Distribution</h3>
                    <div id="myPlot" class="chart-plot"></div>
                </div>
                <div class="chart-card">
                    <h3><i class="fas fa-chart-bar"></i> Recent Activity</h3>
                    <div id="barChart" class="chart-plot"></div>
                </div>
            </div>
        </div>


<!-- Logout Modal -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="logoutModalLabel">Confirm Logout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to log out?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="performLogout()">Logout</button>
            </div>
        </div>
    </div>
</div>

<style>
    /* Fixed CSS */
    body {
        margin: 0;
        padding: 0;
        font-family: Arial, sans-serif;
        background-color: #f4f7fc;
    }

    .dashboard-container {
        display: flex;
        min-height: 100vh;
    }

    .sidebar {
        width: 250px;
        background-color: #2c3e50;
        color: white;
        padding: 20px;
        position: fixed;
        height: 100%;
    }

    .sidebar-header h3 {
        color: #7fb5cf;
        margin: 20px 0;
        padding: 0;
        font-size: 1.5rem;
    }

    .sidebar-menu {
        list-style: none;
        padding: 0;
    }

        .sidebar-menu li {
            margin-bottom: 15px;
        }

        .sidebar-menu a {
            color: #ecf0f1;
            text-decoration: none;
            padding: 10px;
            display: block;
            border-radius: 4px;
            transition: all 0.3s;
        }

            .sidebar-menu a:hover {
                background-color: #34495e;
                padding-left: 15px;
            }

    .main-content {
        margin-left: 250px;
        padding: 30px;
        flex-grow: 1;
        overflow-y: auto;
        padding-top:10%;
    }

    .top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background-color: #34495e;
        color: white;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .btn-logout {
        padding: 8px 20px;
        background-color: #e74c3c;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
        transition: background 0.3s;
    }

        .btn-logout:hover {
            background-color: #c0392b;
        }

    .dashboard-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(00px, 2fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

        .stat-card h3 {
            font-size: 1.1rem;
            margin-bottom: 10px;
            color: #2c3e50;
        }

        .stat-card p {
            font-size: 2rem;
            font-weight: bold;
            color: #3498db;
            margin: 0;
        }

    .chart-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        background: #132125;
        padding: 20px;
        border-radius: 8px;
    }

    /* Chart Card Styling */
    .chart-card {
        background: #1c2b30;
        border-radius: 8px;
        padding: 20px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        text-align: center;
    }

        /* Heading Styling */
        .chart-card h3 {
            color: #ffffff;
            margin-bottom: 15px;
        }

    /* Chart Plot Styling */
    .chart-plot {
        height: 400px;
        background: white;
        border-radius: 8px;
        padding: 15px;
    }

    /* Responsive Design */
    @@media (max-width: 1200px) {
        .chart-container

    {
        grid-template-columns: 1fr;
    }

    }

    @@media (max-width: 768px) {
        .dashboard-container {
            flex-direction: column;
        }

        .sidebar {
            position: relative;
            width: 100%;
            height: auto;
        }

        .main-content {
            margin-left: 0;
            padding: 20px;
        }

        .dashboard-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize Pie Chart
        const pieData = [{
            values: @Html.Raw(Json.Serialize(counts)),
            labels: @Html.Raw(Json.Serialize(categories)),
            type: 'pie',
            hole: .4,
            marker: { colors: ['#3498db', '#2ecc71', '#e74c3c', '#9b59b6', '#f1c40f'] }
        }];

        Plotly.newPlot('myPlot', pieData, {
            title: 'Category Distribution',
            showlegend: true,
            responsive: true
        });

        // Initialize Bar Chart
        const barData = [{
            x: @Html.Raw(Json.Serialize(categories)),
            y: @Html.Raw(Json.Serialize(counts)),
            type: 'bar',
            marker: { color: '#3498db' }
        }];

        Plotly.newPlot('barChart', barData, {
            title: 'Category Statistics',
            responsive: true
        });

        // Handle window resize
        window.addEventListener('resize', () => {
            Plotly.Plots.resize('myPlot');
            Plotly.Plots.resize('barChart');
        });
    });

    function showLogoutConfirmation() {
        new bootstrap.Modal(document.getElementById('logoutModal')).show();
    }

    function performLogout() {
        window.location.href = "/Account/Login";
    }
</script>