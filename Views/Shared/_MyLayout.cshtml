<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"] - My Website</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1"> <!-- Ensure responsiveness -->
    <!-- ✅ Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Include Font Awesome from CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha384-DyZv5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5" crossorigin="anonymous" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        .navbar-nav .nav-link.active {
            color: white !important;
            background-color: #007bff !important; /* Bootstrap primary color */
            border-radius: 5px;
        }

        body {
            font-family: 'Arial', sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
    background: linear-gradient(to right, #141E30, #243B55);

         }

        .content {
            flex-grow: 1;
            padding-bottom: 60px; /* Prevent content from getting hidden by footer */
        }

        .sidebar {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
        }

        .fakeimg {
            height: 200px;
            background: linear-gradient(45deg, #ccc, #eee);
            border-radius: 8px;
        }

        .footer {
            background: #343a40;
            color: white;
            text-align: center;
            padding: 40px 0;
            margin-top: auto;
        }

            .footer p {
                font-size: 1rem;
                margin-bottom: 10px;
            }

            .footer a {
                text-decoration: none;
                color: #00c6ff;
                transition: color 0.3s;
            }

                .footer a:hover {
                    color: #ffcc00;
                }

        .social-icon {
            font-size: 1.5rem;
            transition: color 0.3s;
        }

            .social-icon:hover {
                color: #ffcc00;
            }

        #profilePic {
            border-radius: 50%;
            max-width: 32px;
            max-height: 32px;
        }.Section{
            display: flex;
        justify-content: center;
        align-items: center;
        }
    </style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

</head>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<body>


    <!-- ✅ Navbar -->
    <partial name="_NavPartial" />

    <!-- ✅ Main Content -->

    
 <div class="container d-flex justify-content-center align-items-center content">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

    <!-- ✅ Footer -->

    
      <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <!-- Include FontAwesome for social media icons -->
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>

    <!-- ✅ Scripts -->
    @RenderSection("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const navLinks = document.querySelectorAll(".navbar-nav .nav-link");

            // Function to highlight the active link
            function highlightActiveLink() {
                const currentPath = window.location.pathname;

                navLinks.forEach(link => {
                    if (link.getAttribute("href") === currentPath) {
                        link.classList.add("active");
                    } else {
                        link.classList.remove(link.classList.remove("active");
                    }
                });
            }

            // Call function on page load
            highlightActiveLink();

            // Add event listener to update active class on click
            navLinks.forEach(link => {
                link.addEventListener("click", function () {
                    highlightActiveLink(); // Update active link on click
                });
            });
        });
    </script>

    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>