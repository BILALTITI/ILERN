@using Assigment2.ViewModel
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Proper Font Awesome CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
          integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw=="
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
    <!-- Include Font Awesome from CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" integrity="sha384-DyZv5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5g5" crossorigin="anonymous" />


</head>

<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container-fluid">
        <!-- Brand Logo with Icon -->
        <a class="navbar-brand d-flex align-items-center" asp-action="Index" asp-controller="Home">
            <i class="fas fa-graduation-cap me-2"></i>
            <span class="fw-bold">ILern</span>
        </a>

        <!-- Mobile Toggler -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNav">
            <!-- Navigation Menu -->
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Instructor" asp-action="Index">
                        <i class="fas fa-chalkboard-teacher me-1"></i>Instructors
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Deparment" asp-action="Index">
                        <i class="fas fa-building me-1"></i>Departments
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Course" asp-action="Index">
                        <i class="fas fa-book-open me-1"></i>Courses
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Trainee" asp-action="Index">
                        <i class="fas fa-user-graduate me-1"></i>Trainees
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="CourseResult" asp-action="Index">
                        <i class="fas fa-chart-bar me-1"></i>Results
                    </a>
                </li>
            </ul>

            <!-- Right Navigation Section -->
            <div class="d-flex align-items-center">
                <!-- Search Form -->
                <form class="d-flex me-3" role="search">
                    <div class="input-group">
                        <input type="search" class="form-control form-control-sm" placeholder="Search..."
                               aria-label="Search" disabled>
                        <button class="btn btn-outline-light btn-sm" type="submit">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </form>
                <div class="dropdown">
                    <button class="btn btn-outline-light dropdown-toggle d-flex align-items-center gap-2"
                            type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <img src="@User.Claims.FirstOrDefault(c => c.Type == "ProfilePicture")?.Value"
                             onerror="this.onerror=null; this.src='/images/default-profile.png';"
                             class="rounded-circle"
                             style="width: 32px; height: 32px; object-fit: cover;"
                             alt="Profile Picture">
                        <span class="fw-semibold">@User.Identity.Name</span>
                    </button>
                    

                    <!-- This menu must be INSIDE the dropdown div -->
                    <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark">
                        <li>
                            <a class="dropdown-item" asp-controller="Home" asp-action="Dashboard">
                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-action="Settings" asp-controller="Account">
                                <i class="fas fa-cog me-2"></i>Settings
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <!-- Changed to proper logout form -->
                            <form asp-controller="Account" asp-action="Logout" method="post" class="dropdown-item">
                                <button type="submit" class="btn btn-link text-danger p-0">
                                    <i class="fas fa-sign-out-alt me-2"></i>Logout
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
</nav>

<!-- Logout Modal -->
<div class="modal fade" id="logoutModal" tabindex="-1" aria-labelledby="logoutModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="logoutModalLabel">Confirm Logout</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to log out?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a href="/Account/Login" class="btn btn-danger">Logout</a>
            </div>
        </div>
    </div>
</div>
 
    <script>
        document.getElementById('logoutBtn').addEventListener('click', function(e) {
            e.preventDefault();
            new bootstrap.Modal(document.getElementById('logoutModal')).show();
        });
    </script>

<!-- At end of body -->
