@using Assigment2.ViewModel
@model SettingsViewModel
@{
    ViewData["Title"] = "Account Settings";
    Layout = "_Layout"; // Use your site's layout
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-primary text-white rounded-top-4 py-4">
            <h2 class="h4 mb-0">
                <i class="fas fa-cog me-2"></i>Account Settings
            </h2>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="UpdateSettings" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <!-- Account Information Section -->
                <div class="mb-4">
                    <h3 class="h5 mb-3 text-primary">
                        <i class="fas fa-user-circle me-2"></i>Basic Information
                    </h3>

                    <div class="form-floating mb-4">
                        <input asp-for="UserName" class="form-control form-control-lg"
                               placeholder="Username"   />
                        <label asp-for="UserName" class="form-label">
                            <i class="fas fa-user-tag me-2"></i>Username
                        </label>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="Email" type="email" class="form-control form-control-lg"
                               placeholder="Email address" required />
                        <label asp-for="Email" class="form-label">
                            <i class="fas fa-envelope me-2"></i>Email Address
                        </label>
                        <span asp-validation-for="Email" class="invalid-feedback"></span>
                    </div>
                </div>

                <!-- Password Change Section -->
                <div class="mb-4">
                    <h3 class="h5 mb-3 text-primary">
                        <i class="fas fa-lock me-2"></i>Password Management
                    </h3>

                    <div class="form-floating mb-4">
                        <input asp-for="OldPassword" type="password"
                               class="form-control form-control-lg"
                               placeholder="Old password" />
                        <label asp-for="OldPassword" class="form-label">
                            <i class="fas fa-key me-2"></i>New Password
                        </label>
                        <span asp-validation-for="OldPassword" class="invalid-feedback"></span>
                    </div>
                    <div class="form-floating mb-4">
                        <input asp-for="NewPassword" type="password"
                               class="form-control form-control-lg"
                               placeholder="New password" />
                        <label asp-for="NewPassword" class="form-label">
                            <i class="fas fa-key me-2"></i>New Password
                        </label>
                        <span asp-validation-for="NewPassword" class="invalid-feedback"></span>
                    </div>

                    <div class="form-floating mb-4">
                        <input asp-for="ConfirmPassword" type="password"
                               class="form-control form-control-lg"
                               placeholder="Confirm password" />
                        <label asp-for="ConfirmPassword" class="form-label">
                            <i class="fas fa-check-circle me-2"></i>Confirm Password
                        </label>
                        <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                    </div>
                </div>

                <!-- Form Actions -->
                <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-5">
                    <a asp-action="Index" asp-controller="Home"
                       class="btn btn-lg btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-lg btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
 
    <style>
        .form-floating > label {
            padding-left: 2.5rem;
        }

        .form-control {
            padding-left: 2.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.25);
                border-color: #0d6efd;
            }

        .invalid-feedback {
            padding-left: 2.5rem;
        }
    </style>
 
 
    <script>
        // Bootstrap validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
 