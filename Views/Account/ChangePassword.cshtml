@using Assigment2.ViewModel
@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-primary text-white rounded-top-4 py-4">
            <h2 class="h4 mb-0">
                <i class="fas fa-lock me-2"></i>Change Password
            </h2>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="ChangePassword" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <!-- Current Password -->
                <div class="form-floating mb-4">
                    <input asp-for="OldPassword" type="password"
                           class="form-control form-control-lg"
                           placeholder="Old password" required />
                    <label asp-for="OldPassword" class="form-label">
                        <i class="fas fa-key me-2"></i>Current Password
                    </label>
                    <span asp-validation-for="OldPassword" class="invalid-feedback"></span>
                </div>

                <!-- New Password -->
                <div class="form-floating mb-4">
                    <input asp-for="NewPassword" type="password"
                           class="form-control form-control-lg"
                           placeholder="New password" required />
                    <label asp-for="NewPassword" class="form-label">
                        <i class="fas fa-lock me-2"></i>New Password
                    </label>
                    <span asp-validation-for="NewPassword" class="invalid-feedback"></span>
                </div>

                <!-- Confirm New Password -->
                <div class="form-floating mb-4">
                    <input asp-for="ConfirmPassword" type="password"
                           class="form-control form-control-lg"
                           placeholder="Confirm new password" required />
                    <label asp-for="ConfirmPassword" class="form-label">
                        <i class="fas fa-check-circle me-2"></i>Confirm Password
                    </label>
                    <span asp-validation-for="ConfirmPassword" class="invalid-feedback"></span>
                </div>

                <!-- Form Actions -->
                <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Profile" asp-controller="Account"
                       class="btn btn-lg btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-lg btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Change Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
 
    <style>
        :root {
            --primary-color: #4CAF50;
            --secondary-color: #2196F3;
            --background-color: #f8f9fa;
            --text-color: #2c3e50;
        }

        .form-floating > label {
            padding-left: 2.5rem;
        }

        .form-control {
            padding-left: 2.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.25);
                border-color: var(--primary-color);
            }

        .invalid-feedback {
            padding-left: 2.5rem;
        }
    </style>
 
 
    <script>
        // Bootstrap validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
 