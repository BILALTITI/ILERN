@using Assigment2.ViewModel
@model ProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
    Layout = "_Layout"; // Use your site's layout
}

<div class="container py-5">
    <div class="card border-0 shadow-lg rounded-4" style="max-width: 700px; margin: 0 auto;">
        <div class="card-header bg-primary text-white rounded-top-4 py-4">
            <h2 class="h4 mb-0">
                <i class="fas fa-user-edit me-2"></i>Edit Profile
            </h2>
        </div>

        <div class="card-body p-4 p-md-5">
            <form asp-action="Edit" method="post" class="needs-validation" novalidate>
                @Html.AntiForgeryToken()

                <!-- User Information Section -->
                <div class="form-floating mb-4">
                    <input asp-for="UserName" type="text"
                           class="form-control form-control-lg"
                           placeholder="Username" required />
                    <label asp-for="UserName" class="form-label">
                        <i class="fas fa-user-tag me-2"></i>Username
                    </label>
                    <span asp-validation-for="UserName" class="invalid-feedback"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Email" type="email"
                           class="form-control form-control-lg"
                           placeholder="Email address" required />
                    <label asp-for="Email" class="form-label">
                        <i class="fas fa-envelope me-2"></i>Email Address
                    </label>
                    <span asp-validation-for="Email" class="invalid-feedback"></span>
                </div>

                <!-- Form Actions -->
                <div class="d-grid gap-3 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Profile" asp-controller="Account"
                       class="btn btn-lg btn-outline-secondary px-4">
                        <i class="fas fa-times me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-lg btn-primary px-4">
                        <i class="fas fa-save me-2"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
 
    <style>
        :root {
            --primary-color: #4CAF50;
            --secondary-color: #2196F3;
            --background-color: #f8f9fa;
            --text-color: #2c3e50;
        }

        .form-floating > label {
            padding-left: 2.5rem;
        }

        .form-control {
            padding-left: 2.5rem;
            border-radius: 0.5rem;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(76, 175, 80, 0.25);
                border-color: var(--primary-color);
            }

        .invalid-feedback {
            padding-left: 2.5rem;
        }
    </style> 
     <script>
        // Bootstrap validation
        (() => {
            'use strict'
            const forms = document.querySelectorAll('.needs-validation')
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault()
                        event.stopPropagation()
                    }
                    form.classList.add('was-validated')
                }, false)
            })
        })()
    </script>
 